{
  "app": {
    "bundleName": "com.jjas.tools.watch",
    "vendor": "example",
    "version": {
      "code": 1000000,
      "name": "1.0.0"
    }
  },
  "deviceConfig": {},
  "module": {
    "deviceType": [
      "liteWearable"
    ],
    "distro": {
      "deliveryWithInstall": true,
      "moduleName": "entry",
      "moduleType": "entry"
    },
    "abilities": [
      {
        "name": ".MainAbility",
        "srcLanguage": "js",
        "srcPath": "MainAbility",
        "icon": "$media:icon",
        "description": "$string:MainAbility_desc",
        "label": "$string:MainAbility_label",
        "type": "page"
      }
    ],
    "js": [
      {
        "pages": [
          "pages/index/index",
          "pages/music/music",
          "pages/playlists/playlists",
          "pages/tracks/tracks",
          "pages/shutter/shutter",
          "pages/battery/battery",
          "pages/bike/bike",
          "pages/watchbat/watchbat",
          "pages/batedit/batedit",
          "pages/work/work",
          "pages/workedit/workedit",
          "pages/metro/metro",
          "pages/metroline/metroline",
          "pages/metrocard/metrocard",
          "pages/units/units",
          "pages/unitconv/unitconv",
          "pages/brief/brief"
        ],
        "name": ".MainAbility"
      }
    ]
  }
}