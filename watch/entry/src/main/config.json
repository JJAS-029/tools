{
  "app": {
    "bundleName": "com.jjas.tools.watch",
    "vendor": "jjas",
    "version": {
      "code": 1000000,
      "name": "1.0.0"
    }
  },
  "deviceConfig": {},
  "module": {
    "deviceType": [
      "liteWearable"
    ],
    "distro": {
      "deliveryWithInstall": true,
      "moduleName": "entry",
      "moduleType": "entry"
    },
    "abilities": [
      {
        "name": ".MainAbility",
        "srcLanguage": "js",
        "srcPath": "MainAbility",
        "icon": "$media:icon",
        "description": "$string:MainAbility_desc",
        "label": "$string:MainAbility_label",
        "type": "page"
      }
    ],
    "js": [
      {
        "pages": [
          "pages/index/index",
          "pages/music/music",
          "pages/playlists/playlists",
          "pages/tracks/tracks",
          "pages/shutter/shutter",
          "pages/battery/battery",
          "pages/bike/bike",
          "pages/watchbat/watchbat",
          "pages/batedit/batedit",
          "pages/work/work",
          "pages/workedit/workedit",
          "pages/metro/metro",
          "pages/metroline/metroline",
          "pages/metrocard/metrocard",
          "pages/units/units",
          "pages/unitconv/unitconv",
          "pages/brief/brief",
          "pages/counter/counter",
          "pages/tip/tip",
          "pages/decide/decide",
          "pages/qr/qr",
          "pages/hnc/hnc",
          "pages/places/places",
          "pages/placego/placego",
          "pages/hwtest/hwtest",
          "pages/koala/koala",
          "pages/bikecare/bikecare",
          "pages/signal/signal",
          "pages/timer/timer",
          "pages/habits/habits",
          "pages/vibeclock/vibeclock",
          "pages/anki/anki",
          "pages/days/days",
          "pages/spend/spend",
          "pages/simon/simon",
          "pages/kbd/kbd",
          "pages/prompter/prompter",
          "pages/ride/ride"
        ],
        "name": ".MainAbility"
      }
    ],
    "reqPermissions": [
      {
        "name": "ohos.permission.VIBRATE",
        "reason": "Vibración al tocar, temporizadores y avisos",
        "usedScene": {
          "ability": [
            ".MainAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.LOCATION",
        "reason": "Lugares (distancia y dirección) y modo bici con GPS",
        "usedScene": {
          "ability": [
            ".MainAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.ACTIVITY_MOTION",
        "reason": "Pasos para alimentar al Koala",
        "usedScene": {
          "ability": [
            ".MainAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.READ_HEALTH_DATA",
        "reason": "Zonas de pulso en el modo bici",
        "usedScene": {
          "ability": [
            ".MainAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.ACCELEROMETER",
        "reason": "Sacudir la muñeca para tomar la foto",
        "usedScene": {
          "ability": [
            ".MainAbility"
          ],
          "when": "inuse"
        }
      }
    ]
  }
}