<div class="page" onswipe="onSwipe">
    <div class="chip" style="background-color: {{ pContainer }};">
        <text class="chip-text" style="color: {{ pAccent }};">{{ chipText }}</text>
    </div>

    <!-- "Cover": M3 shape and color per song; spins while playing -->
    <image-animator class="art" ref="anim" show="{{ playing }}" images="{{ artFrames }}"
                    iteration="infinite" duration="900ms"></image-animator>
    <image class="art" show="{{ !playing }}" src="{{ artIcon }}"></image>

    <text class="title">{{ title }}</text>
    <text class="artist">{{ artist }}</text>

    <!-- Sinusoidal wavy progress bar (M3 Expressive) -->
    <canvas id="wave" class="wave" ref="wave"></canvas>

    <!-- Button group: the center one changes shape (pill ↔ rounded square) -->
    <div class="controls">
        <div class="side" style="background-color: {{ pContainer }};" onclick="prev">
            <image class="ico-s" src="/common/images/prev.png"></image>
        </div>
        <div class="main" style="border-radius: {{ playRadius }}px; background-color: {{ pAccent }};" onclick="toggle">
            <image class="ico-l" src="{{ playIcon }}"></image>
        </div>
        <div class="side" style="background-color: {{ pContainer }};" onclick="next">
            <image class="ico-s" src="/common/images/next.png"></image>
        </div>
    </div>

    <div class="volume" style="background-color: {{ pSurface }};">
        <div class="vbtn" onclick="volDown">
            <image class="ico-v" src="/common/images/vol_down.png"></image>
        </div>
        <slider class="vslider" ref="vol" min="0" max="100" value="{{ vol }}"
                style="selected-color: {{ pAccent }}; block-color: {{ pAccent }};" onchange="onVol"></slider>
        <div class="vbtn" onclick="volUp">
            <image class="ico-v" src="/common/images/vol_up.png"></image>
        </div>
    </div>
</div>
