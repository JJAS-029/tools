<div class="page" onswipe="onSwipe">
    <!-- Tap chip to cycle max heart-rate alert threshold -->
    <div class="chip" style="background-color: {{ chipBg }};" onclick="nextLimit">
        <text class="chip-text" style="color: {{ chipCol }};">{{ limitText }}</text>
    </div>
    <div class="hero" style="background-color: {{ heroBg }};">
        <text class="speed" style="color: {{ heroCol }};">{{ speedText }}</text>
        <text class="unit">km/h · GPS</text>
    </div>
    <div class="cards">
        <div class="mini" style="background-color: {{ hrBg }};">
            <text class="mini-val" style="color: {{ hrCol }};">{{ hrText }}</text>
            <text class="mini-lbl">{{ zoneText }}</text>
        </div>
        <div class="mini">
            <text class="mini-val">{{ rangeText }}</text>
            <text class="mini-lbl">Autonomía</text>
        </div>
    </div>
</div>
