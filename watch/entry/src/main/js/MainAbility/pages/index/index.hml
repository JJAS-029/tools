<div class="page" onswipe="onSwipe">
    <text class="header">JJAS Tools</text>
    <list class="menu" ref="list">
        <list-item for="{{ apps }}" class="row" onclick="open({{ $idx }})">
            <div class="card">
                <image class="tile" src="{{ $item.icon }}"></image>
                <div class="labels">
                    <text class="name">{{ $item.name }}</text>
                    <text class="sub">{{ $item.sub }}</text>
                </div>
            </div>
        </list-item>
        <list-item class="tail"></list-item>
    </list>
</div>
