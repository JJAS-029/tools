<div class="page" onswipe="onSwipe">
    <!-- Tap the chip: photo <-> video -->
    <div class="chip" style="background-color: {{ chipBg }};" onclick="toggleMode">
        <text class="chip-text" style="color: {{ chipColor }};">{{ chip }}</text>
    </div>
    <text class="status" style="color: {{ statusColor }};">{{ status }}</text>

    <!-- Photo: M3 "cookie" shutter. Video: red dot to record, square to stop -->
    <image class="shutter" src="{{ shutterIcon }}" onclick="shoot"></image>

    <div class="row">
        <div class="pill" onclick="cycleTimer">
            <image class="ico" src="/common/images/timer.png"></image>
            <text class="pill-text">{{ timerText }}</text>
        </div>
        <div class="pill" onclick="flip">
            <image class="ico" src="/common/images/flip.png"></image>
            <text class="pill-text">{{ sideText }}</text>
        </div>
    </div>
</div>
